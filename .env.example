# --- Gemini / Gemma (Google AI Studio free tier) ---
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model IDs move fast — confirm the current ones in AI Studio before you rely on these.
# Must satisfy the hackathon's "Gemini 3.5 or newer" requirement.
GEMINI_MODEL=gemini-flash-latest
# Gemma 4 shipped April 2026 — check AI Studio for the exact current id.
GEMMA_MODEL=gemma-3-27b-it

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_DATABASE=(default)

# --- Warden ---
# Any random long string — used to sign task-bounded authorization tokens (HMAC-SHA256).
WARDEN_SECRET_KEY=change-me-to-a-random-string

# When true (or when GOOGLE_API_KEY is empty), triage/review return deterministic stub
# decisions so the demo runs with zero API calls and zero cost. Flip off once your key works.
WARDEN_STUB_MODE=true

PORT=8080
