# --- Model backend ---
# "ollama": local, free, zero setup beyond having Ollama running — start here.
# "gemini": cloud, Gemini Developer API / AI Studio key, free tier — for
#   once the local pipeline is proven out. This is what's actually deployed.
# "vertex": cloud, Vertex AI + Model Armor prompt/response screening —
#   verified working end-to-end (see scripts/setup_model_armor.sh), but
#   opt-in and not the deployed default: no AI-Studio-style free tier, and
#   this project's Vertex AI catalog only has access up to gemini-2.5-flash
#   (every 3.x model 404s — verified via client.models.list(), not
#   assumed). Demonstrates the Model Armor integration path; "gemini"
#   above is what satisfies the hackathon's Gemini 3.5+ requirement.
MODEL_BACKEND=ollama

# --- Ollama (local) ---
OLLAMA_HOST=http://localhost:11434
# Small on purpose — swap for whatever you've already got pulled locally.
# `ollama list` to see what's available; `ollama pull <model>` if not.
OLLAMA_TRIAGE_MODEL=gemma2:2b
# llama3.1:8b, not gemma2:2b — tested, not assumed: gemma2:2b as reviewer
# aborted 3 real orchestrated trips in a row on hallucinated blocks of
# calls that were actually in scope. llama3.1:8b ran the full 9-step trip
# clean, including the orchestrator's retry-after-block. See warden/config.py.
OLLAMA_REVIEW_MODEL=llama3.1:8b

# --- Gemini / Gemma (Google AI Studio free tier) — only used once MODEL_BACKEND=gemini ---
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model IDs move fast — confirm the current ones in AI Studio before you rely on these.
# Pinned, not gemini-flash-latest: verified live, the rolling "-latest"
# alias hit a real 504 DEADLINE_EXCEEDED on 11/11 consecutive reviewer
# calls across three Cloud Run trip runs — whatever model version
# "-latest" currently points to is unstable/overloaded. gemini-3.5-flash
# pinned: 4/4 success locally, 1-7s instead of 20-35s per call. Also
# satisfies the hackathon's "Gemini 3.5 or newer" requirement directly.
GEMINI_MODEL=gemini-3.5-flash
# Verified against the live API, not assumed — gemma-4-4b-it/12b-it 404
# on this API version despite being real Gemma 4 sizes; only 26b-a4b and
# 31b are actually exposed. 26b-a4b is a mixture-of-experts model with
# ~4B active params, the smaller of the two — still "cheapest that works".
GEMMA_MODEL=gemma-4-26b-a4b-it

# --- Google Cloud ---
# Leave empty for local dev — registry.py/ledger.py fall back to in-memory
# stores when this is blank. Only set it once you actually deploy; setting
# it locally makes the gateway try to reach Firestore and fail with a
# DefaultCredentialsError.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)

# --- Vertex AI + Model Armor (only used once MODEL_BACKEND=vertex) ---
# Run scripts/setup_model_armor.sh once first — it enables the APIs,
# grants IAM, creates the template, and prints these values.
VERTEX_LOCATION=us-central1
MODEL_ARMOR_PROMPT_TEMPLATE=
MODEL_ARMOR_RESPONSE_TEMPLATE=

# --- Warden ---
# Any random long string — used to sign task-bounded authorization tokens (HMAC-SHA256).
WARDEN_SECRET_KEY=change-me-to-a-random-string

# true = skip both model backends entirely, deterministic decisions. For
# tests/CI, not for actually seeing the reviewer's reasoning — leave false.
WARDEN_STUB_MODE=false

PORT=8080
